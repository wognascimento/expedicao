<Window x:Class="Expedicao.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
        Title="SISTEMA INTEGRADO DE GERENCIAMENTO - EXPEDIÇÃO"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Height="350" Width="525">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <telerik:RadMenu Grid.Row="0">
            <telerik:RadMenuItem Header="Expedição Material">
                <telerik:RadMenuItem Click="expedProduto_Click" Name="expedProduto" Header="Produto"/>
                <telerik:RadMenuItem Click="expedImprimirEtiqueta_Click" Name="expedImprimirEtiqueta" Header="Imprimir"/>
                <telerik:RadMenuItem Click="liberarImpressao_Click" Name="liberarImpressao" Header="Liberar Impressão"/>
            </telerik:RadMenuItem>
            <telerik:RadMenuItem Header="Controle de Carga">
                <telerik:RadMenuItem Header="Romaneio ">
                    <telerik:RadMenuItem Click="expedNovoRomaneio_Click" Name="expedNovoRomaneio" Header="Novo"/>
                    <telerik:RadMenuItem Click="expedTodosRomaneios_Click" Name="expedTodosRomaneios" Header="Todos"/>
                </telerik:RadMenuItem>
                <telerik:RadMenuItem Click="expedColetarDados_Click" Name="expedColetarDados" Header="Coletar dados"/>
                <telerik:RadMenuItem Header="Nota Teorica">
                    <telerik:RadMenuItem Click="expedNotaCaminhao" Name="expedNotaCaminao" Header="Nota por Caminão"/>
                    <telerik:RadMenuItem Click="expedNotaCliente_Click" Name="expedNotaCliente" Header="Nota por Cliente"/>
                </telerik:RadMenuItem>
                
                <telerik:RadMenuItem Click="ItensFaltantes_Click" Name="ItensFaltantes" Header="Itens Faltantes"/>
                <telerik:RadMenuItem Click="ItensCarregados_Click" Name="ItensCarregados" Header="Itens Carregados"/>
            </telerik:RadMenuItem>
            <telerik:RadMenuItem Header="Pré-conferencia">
                <telerik:RadMenuItem Header="Itens Faltantes" Click="OnPreItensFaltantesClick"/>
                <telerik:RadMenuItem Header="Itens Conferidos" Click="OnPreItensCarregadosClick"/>
            </telerik:RadMenuItem>
            <telerik:RadMenuItem Header="Consultas">
                <telerik:RadMenuItem Header="T Exped" Click="OnExpedClick"/>
                <telerik:RadMenuItem Header="Caixas endereçadas" Click="OnCaixasEnderecadasClick"/>
                <Separator/>
                <telerik:RadMenuItem Header="Saldo Geral Expedido por Shopping" Click="OnSaldoGeralShoppingClick"/>
                <telerik:RadMenuItem Header="Produtos Expedido por Data" Click="OnProdutosExpedidoDataClick"/>
                <Separator/>
                <telerik:RadMenuItem Header="Cubagem ">
                    <telerik:RadMenuItem Header="Expedida por Dia" Click="OnCubagemDiaClick"/>
                    <telerik:RadMenuItem Header="Semana Ano Anterior x Ano Atual" Click="OnCubagemSemanaAnosClick"/>
                    <telerik:RadMenuItem Header="Prevista por Cliente" Click="OnCubagemPrevistaClienteClick"/>
                    <telerik:RadMenuItem Header="Prevista Cliente Zerada" Click="OnCubagemZeradaClienteClick"/>
                    <telerik:RadMenuItem Header="Cliente Fracionada por Caminhão" Click="OnCubagemFracionadaCaminao"/>
                    <telerik:RadMenuItem Header="Cliente Efetiva" Click="OnCubagemEfetivaClick"/>
                    <telerik:RadMenuItem Header="Pendências Expedição" Click="OnPendenciaExpedicaoClick"/>
                </telerik:RadMenuItem>
                <telerik:RadMenuItem Header="Expedição Virtual" Click="OnExpedicaoVirtualClick"/>
            </telerik:RadMenuItem>

            <telerik:RadMenuItem Header="Produtos Matic" Click="OnProdutoCSVClick"/>
        </telerik:RadMenu>

        <telerik:RadDocking
            x:Name="radDocking"
            Grid.Row="1"
            HasDocumentHost="True">
            <telerik:RadDocking.DocumentHost>
                <telerik:RadSplitContainer>
                    <telerik:RadPaneGroup x:Name="documentGroup"/>
                </telerik:RadSplitContainer>
            </telerik:RadDocking.DocumentHost>
        </telerik:RadDocking>

        <StatusBar Grid.Row="2">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="4*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <StatusBarItem>
                <Image Source="/icon/icons8-usu_0025c3_0025a1rio-de-g_0025c3_0025aanero-neutro-windows-metro-16.png" Width="16" Height="16" MouseDown="OnAlterarUsuario"/>
            </StatusBarItem>
            <StatusBarItem Grid.Column="1">
                <TextBlock x:Name="txtUsername"/>
            </StatusBarItem>
            <StatusBarItem Grid.Column="2">
                <telerik:RadProgressBar Name="PbLoading" Height="20" Value="80" Width="100" IsIndeterminate="True" Visibility="Hidden"/>
            </StatusBarItem>
            <StatusBarItem Grid.Column="3">
                <Image Source="/icon/configuracao-de-dados-windows-metro-16.png" Width="16" Height="16" MouseDown="Image_MouseDown"/>
            </StatusBarItem>
            <StatusBarItem Grid.Column="4">
                <TextBlock x:Name="txtDataBase"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>


</Window>
