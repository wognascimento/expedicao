<UserControl x:Class="Expedicao.Views.ViewExpedicaoLookupCaminao"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:local="clr-namespace:Expedicao.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" 
             Loaded="UserControl_Loaded">

    <Grid>
        <telerik:RadGridView
            x:Name="itens"
            AutoGenerateColumns="False"
            IsFilteringAllowed="True"
            ShowGroupPanel="False"
            CanUserResizeColumns="True"
            IsReadOnly="False"
            Margin="0,0,0,65">
            <telerik:RadGridView.Columns>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding sigla}" Header="sigla" IsReadOnly="True"/>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding caminao}" Header="caminao" DataFormatString="{}{0:N0}" IsReadOnly="True"/>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding volumes}" Header="volumes" DataFormatString="{}{0:N0}" IsReadOnly="True"/>
                <telerik:GridViewCheckBoxColumn DataMemberBinding="{Binding selecao, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="selecao"/>
            </telerik:RadGridView.Columns>
        </telerik:RadGridView>
        <telerik:RadBusyIndicator x:Name="loadingDetalhes" Height="50" VerticalAlignment="Bottom" IsBusy="True"/>
        <Border x:Name="loadingBtn" Height="60" VerticalAlignment="Bottom" BorderThickness="1" Opacity="50"
            Visibility="Hidden">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <Button Click="Button_Click" Content="Baixar Volumes" Margin="5"/>
            </StackPanel>
        </Border>
    </Grid>

</UserControl>
