<UserControl x:Class="Expedicao.Views.ViewExpedicaoLiberarImpressao"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:local="clr-namespace:Expedicao.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Initialized="UserControl_Initialized">

    <Grid>
        <telerik:RadBusyIndicator x:Name="loadingDetalhes" IsBusy="True">
            <telerik:RadGridView
                x:Name="itens"
                AutoGenerateColumns="False"
                IsFilteringAllowed="True"
                ShowGroupPanel="False"
                CanUserResizeColumns="True"
                IsReadOnly="False"
                ItemsSource="{Binding CaixaCollection}">
                <telerik:RadGridView.Columns>
                    <telerik:GridViewDataColumn DataMemberBinding="{Binding Sigla}" Header="Sigla" IsReadOnly="True"/>
                    <telerik:GridViewDataColumn DataMemberBinding="{Binding Planilha}" Header="Planilha" IsReadOnly="True"/>
                    <telerik:GridViewDataColumn DataMemberBinding="{Binding NomeCaixa}" Header="NomeCaixa" IsReadOnly="True"/>
                    <telerik:GridViewDataColumn Header="Impresso" IsReadOnly="True">
                        <telerik:GridViewDataColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsThreeState="False"
                                    IsChecked="{Binding Impresso, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Click="ImpressoCheckBox_Click"/>
                            </DataTemplate>
                        </telerik:GridViewDataColumn.CellTemplate>
                    </telerik:GridViewDataColumn>
                </telerik:RadGridView.Columns>
            </telerik:RadGridView>
        </telerik:RadBusyIndicator>
    </Grid>

</UserControl>
