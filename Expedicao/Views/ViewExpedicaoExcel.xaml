<UserControl x:Class="Expedicao.Views.ViewExpedicaoExcel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:local="clr-namespace:Expedicao.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" 
             Loaded="UserControl_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="load">
            <telerik:RadBusyIndicator 
                Name="sfBusyIndicator" 
                IsBusy="True" 
                HorizontalAlignment="Center" 
                VerticalAlignment="Center"
                Background="White"/>
        </Grid>
        
        <Grid x:Name="principal" Visibility="Hidden" Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="txtFiltro"
                     Grid.Column="0"
                     Margin="0,0,10,8"
                     TextChanged="txtFiltro_TextChanged"/>
            
            <Button Click="btnExcel_Click" Name="btnExcel" Grid.Column="1" Margin="0,0,10,8">
                <Image Source="/icon/icons8-microsoft-excel-40.png"/>
            </Button>
            
            <telerik:RadBusyIndicator 
                Name="sfBusyIndicatorExcel" 
                Grid.Column="2" 
                IsBusy="False" 
                HorizontalAlignment="Center" 
                VerticalAlignment="Center"
                Background="White" 
                Margin="0,0,10,8"/>

            <ListView x:Name="aprovadosList"
                      Grid.Row="1"
                      Grid.ColumnSpan="3"
                      ItemsSource="{Binding Aprovados}"
                      SelectionMode="Extended">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Sigla" DisplayMemberBinding="{Binding Sigla}" Width="90"/>
                        <GridViewColumn Header="Sigla Serv" DisplayMemberBinding="{Binding SiglaServ}" Width="120"/>
                        <GridViewColumn Header="Nome" DisplayMemberBinding="{Binding Nome}" Width="320"/>
                        <GridViewColumn Header="Cidade" DisplayMemberBinding="{Binding Cidade}" Width="180"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>
    </Grid>

</UserControl>
