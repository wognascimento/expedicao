<UserControl x:Class="Expedicao.Views.ViewExpedicaoRomaneio"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             mc:Ignorable="d"
             d:DesignHeight="620"
             d:DesignWidth="920"
             Initialized="UserControl_Initialized">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,8">
                <TextBlock Text="Operação"/>
                <telerik:RadComboBox x:Name="operacao" ItemsSource="{Binding OperacoesList}"/>
            </StackPanel>

            <StackPanel Grid.Row="0" Grid.Column="2" Margin="10,0,0,8">
                <TextBlock Text="Número Romaneio"/>
                <telerik:RadNumericUpDown x:Name="cod_romaneiro" IsEnabled="False" Value="0" NumberDecimalDigits="0"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,8">
                <TextBlock Text="Data Carregamento"/>
                <telerik:RadDatePicker x:Name="data_carregamento"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,8">
                <TextBlock Text="Hora Carregamento"/>
                <telerik:RadTimePicker x:Name="hora_chegada" TimeInterval="00:15:00"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,8">
                <TextBlock Text="Shopping"/>
                <telerik:RadListBox x:Name="shopping_destino"
                                    ItemsSource="{Binding Aprovados}"
                                    DisplayMemberPath="SiglaServ"
                                    SelectionMode="Extended"
                                    Height="84"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.Column="1" Margin="10,0,0,8">
                <TextBlock Text="Nº Caminhão"/>
                <telerik:RadNumericUpDown x:Name="numero_caminhao" NumberDecimalDigits="0"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.Column="2" Margin="10,0,0,8">
                <TextBlock Text="Local Carregamento"/>
                <telerik:RadWatermarkTextBox x:Name="local_carregamento" Text="JACAREÍ"/>
            </StackPanel>

            <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,8">
                <TextBlock Text="Transportadora"/>
                <telerik:RadComboBox x:Name="codtransportadora"
                                     ItemsSource="{Binding Tranportadoras}"
                                     DisplayMemberPath="NomeTransportadora"
                                     SelectedValuePath="CodTransportadora"
                                     IsEditable="True"
                                     IsTextSearchEnabled="True"/>
            </StackPanel>

            <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,0,8">
                <TextBlock Text="Motorista"/>
                <telerik:RadWatermarkTextBox x:Name="nome_motorista"/>
            </StackPanel>

            <StackPanel Grid.Row="4" Grid.Column="1" Margin="10,0,0,8">
                <TextBlock Text="Nº CNH"/>
                <telerik:RadWatermarkTextBox x:Name="numero_cnh"/>
            </StackPanel>

            <StackPanel Grid.Row="4" Grid.Column="2" Margin="10,0,0,8">
                <TextBlock Text="Telefone"/>
                <telerik:RadWatermarkTextBox x:Name="telefone_motorista"/>
            </StackPanel>

            <StackPanel Grid.Row="5" Grid.Column="0" Margin="0,0,0,8">
                <TextBlock Text="Condição do Caminhão"/>
                <telerik:RadComboBox x:Name="condicao_caminhao" ItemsSource="{Binding CondicaoCaminhaoList}"/>
            </StackPanel>

            <StackPanel Grid.Row="6" Grid.Column="0" Margin="0,0,0,8">
                <TextBlock Text="Placa Caminhão/Cavalo"/>
                <telerik:RadWatermarkTextBox x:Name="placa_caminhao"/>
            </StackPanel>

            <StackPanel Grid.Row="6" Grid.Column="1" Margin="10,0,0,8">
                <TextBlock Text="Cidade"/>
                <telerik:RadWatermarkTextBox x:Name="placa_cidade"/>
            </StackPanel>

            <StackPanel Grid.Row="6" Grid.Column="2" Margin="10,0,0,8">
                <TextBlock Text="Estado"/>
                <telerik:RadWatermarkTextBox x:Name="placa_estado"/>
            </StackPanel>

            <StackPanel Grid.Row="7" Grid.Column="0" Margin="0,0,0,8">
                <TextBlock Text="Placa Carroceria"/>
                <telerik:RadWatermarkTextBox x:Name="placa_carroceria"/>
            </StackPanel>

            <StackPanel Grid.Row="7" Grid.Column="1" Margin="10,0,0,8">
                <TextBlock Text="Cidade"/>
                <telerik:RadWatermarkTextBox x:Name="placa_carroceria_cidade"/>
            </StackPanel>

            <StackPanel Grid.Row="7" Grid.Column="2" Margin="10,0,0,8">
                <TextBlock Text="Estado"/>
                <telerik:RadWatermarkTextBox x:Name="placa_carroceria_estado"/>
            </StackPanel>

            <StackPanel Grid.Row="8" Grid.Column="0" Margin="0,0,0,8">
                <TextBlock Text="Altura"/>
                <telerik:RadNumericUpDown x:Name="bau_altura" NumberDecimalDigits="2"/>
            </StackPanel>

            <StackPanel Grid.Row="8" Grid.Column="1" Margin="10,0,0,8">
                <TextBlock Text="Largura"/>
                <telerik:RadNumericUpDown x:Name="bau_largura" NumberDecimalDigits="2"/>
            </StackPanel>

            <StackPanel Grid.Row="8" Grid.Column="2" Margin="10,0,0,8">
                <TextBlock Text="Profundidade"/>
                <telerik:RadNumericUpDown x:Name="bau_profundidade" NumberDecimalDigits="2"/>
            </StackPanel>

            <StackPanel Grid.Row="9" Grid.Column="0" Margin="0,0,0,8">
                <TextBlock Text="M³ Carregado"/>
                <telerik:RadNumericUpDown x:Name="m3_carregado" NumberDecimalDigits="2"/>
            </StackPanel>

            <StackPanel Grid.Row="9" Grid.Column="1" Margin="10,0,0,8">
                <TextBlock Text="Sobra"/>
                <telerik:RadNumericUpDown x:Name="bau_soba" NumberDecimalDigits="2"/>
            </StackPanel>

            <StackPanel Grid.Row="9" Grid.Column="2" Margin="10,0,0,8">
                <TextBlock Text="M³ Portaria"/>
                <telerik:RadNumericUpDown x:Name="m3_portaria" NumberDecimalDigits="2"/>
            </StackPanel>

            <StackPanel Grid.Row="10" Grid.Column="0" Margin="0,0,0,8">
                <TextBlock Text="Conferente"/>
                <telerik:RadWatermarkTextBox x:Name="nome_conferente"/>
            </StackPanel>

            <StackPanel Grid.Row="10" Grid.Column="1" Margin="10,0,0,8">
                <TextBlock Text="Num. Lacres"/>
                <telerik:RadWatermarkTextBox x:Name="num_lacres"/>
            </StackPanel>

            <StackPanel Grid.Row="10" Grid.Column="2" Margin="10,0,0,8">
                <TextBlock Text="M³ Num. Container"/>
                <telerik:RadWatermarkTextBox x:Name="numero_container"/>
            </StackPanel>

            <StackPanel Grid.Row="11" Grid.Column="0" Margin="0,0,0,12">
                <TextBlock Text="Data saída"/>
                <telerik:RadDatePicker x:Name="dateSaida"/>
            </StackPanel>

            <StackPanel Grid.Row="12" Grid.Column="0" Orientation="Horizontal">
                <telerik:RadButton Click="btnNovo_Click" x:Name="btnNovo" Content="NOVO" Width="90"/>
                <telerik:RadButton Click="btnGravar_Click" x:Name="btnGravar" Content="GRAVAR" Width="90" Margin="10,0,0,0"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
