<UserControl x:Class="Expedicao.Views.ViewExpedicaoColetaDados"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:local="clr-namespace:Expedicao.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" 
             Loaded="UserControl_Loaded" Unloaded="UserControl_Unloaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <ToolBar Grid.Row="0">
            <telerik:RadButton Click="RibbonButton_Click" Padding="6,3">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/icon/icons8-caminhao-interestadual-32.png" Width="24" Height="24" Margin="0,0,4,0"/>
                    <TextBlock Text="Carregar Romaneio"/>
                </StackPanel>
            </telerik:RadButton>
            <Separator/>
            <telerik:RadButton Click="RibbonButton_Click_1" Padding="6,3">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/icon/icons8-alimentacao-de-papel-32.png" Width="24" Height="24" Margin="0,0,4,0"/>
                    <TextBlock Text="Lookup Itens"/>
                </StackPanel>
            </telerik:RadButton>
            <Separator/>
            <telerik:RadButton Click="RibbonButton_Click_2" Padding="6,3">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/icon/icons8-enviar-documento-32.png" Width="24" Height="24" Margin="0,0,4,0"/>
                    <TextBlock Text="Enviar Itens Carregados"/>
                </StackPanel>
            </telerik:RadButton>
            <Separator/>
            <telerik:RadButton Click="RibbonButton_Click_3" Padding="6,3">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/icon/icons8-enviar-documento-por-e-mail-32.png" Width="24" Height="24" Margin="0,0,4,0"/>
                    <TextBlock Text="Solicitar Nota Fiscal"/>
                </StackPanel>
            </telerik:RadButton>
            <Separator/>
            <telerik:RadButton Click="ButtonAdv_Click" Padding="6,3">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/icon/checklist.png" Width="24" Height="24" Margin="0,0,4,0"/>
                    <TextBlock Text="Pack List"/>
                </StackPanel>
            </telerik:RadButton>
            <Separator/>
            <telerik:RadButton Click="AlterarDados_Click" Padding="6,3" Content="Alterar Volumes"/>
        </ToolBar>
        <telerik:RadGridView x:Name="itens" Grid.Row="2"
                             AutoGenerateColumns="False"
                             IsFilteringAllowed="True"
                             ShowGroupPanel="False"
                             CanUserResizeColumns="True"
                             IsReadOnly="True">
            <telerik:RadGridView.Columns>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding Planilha}" Header="planilha"/>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding DescricaoCompleta}" Header="descricao_completa"/>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding Unidade}" Header="unidade"/>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding QtdExpedida}" Header="qtd_expedida" DataFormatString="{}{0:N2}"/>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding NomeCaixa}" Header="nome_caixa"/>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding Barcode}" Header="barcode"/>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding M3Volume}" Header="m3_volume" DataFormatString="{}{0:N2}"/>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding ItemMemorial}" Header="item_memorial"/>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding BaiaCaminhao}" Header="baia_caminhao"/>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding Endereco}" Header="endereco"/>
            </telerik:RadGridView.Columns>
        </telerik:RadGridView>
        <Grid x:Name="gCaminhoes" Grid.Row="2" Visibility="Hidden" HorizontalAlignment="Center" Width="600"
          VerticalAlignment="Center" Height="450">
            <telerik:RadGridView x:Name="caminoes"
                                 AutoGenerateColumns="False"
                                 IsFilteringAllowed="True"
                                 ShowGroupPanel="False"
                                 CanUserResizeColumns="True"
                                 IsReadOnly="False">
                <telerik:RadGridView.Columns>
                    <telerik:GridViewDataColumn DataMemberBinding="{Binding sigla}" Header="sigla"/>
                    <telerik:GridViewDataColumn DataMemberBinding="{Binding caminao}" Header="caminao" DataFormatString="{}{0:N0}"/>
                    <telerik:GridViewDataColumn DataMemberBinding="{Binding volumes}" Header="volumes" DataFormatString="{}{0:N0}"/>
                    <telerik:GridViewCheckBoxColumn DataMemberBinding="{Binding selecao}" Header="selecao"/>
                </telerik:RadGridView.Columns>
            </telerik:RadGridView>
            <Border x:Name="loadingCaminhoes" Height="60" VerticalAlignment="Bottom" Background="Black"
              BorderBrush="Black" BorderThickness="1" Opacity="50">
                <telerik:RadBusyIndicator Margin="5"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Center"
                                          Foreground="Gray"
                                          IsBusy="True"/>
            </Border>
            <Border x:Name="BtDownload" Height="60" VerticalAlignment="Bottom" BorderThickness="1" Opacity="50"
              Visibility="Hidden">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                    <Button HorizontalAlignment="Right" HorizontalContentAlignment="Right" Content="Baixar Itens"/>
                </StackPanel>
            </Border>
        </Grid>
        <StatusBar Grid.Row="3">
            <Label Content="SIGLA(S):"/>
            <Label x:Name="txtSigla"/>
            <Separator/>
            <Label Content="PLACA:"/>
            <Label x:Name="txtPlaca"/>
            <Separator/>
            <Label Content="CONFERENTE:"/>
            <Label x:Name="txtConferente"/>
            <Separator/>
            <Label Content="VOLUMES:"/>
            <Label x:Name="txtVolumes"/>
        </StatusBar>
        <Border x:Name="loading" Height="60" Grid.Row="2" VerticalAlignment="Bottom" Background="Black"
            BorderBrush="Black" BorderThickness="1" Opacity="50">
            <telerik:RadBusyIndicator Margin="5"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Center"
                                      Foreground="Gray"
                                      IsBusy="True"/>
        </Border>
    </Grid>

</UserControl>
