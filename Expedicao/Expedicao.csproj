	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Impressos\" />
	</ItemGroup>

	<Target Name="IncludeEmptyFolders" AfterTargets="Publish">
		<MakeDir Directories="$(PublishDir)Impressos" />
	</Target>



